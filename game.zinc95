-- Main

local item_table = {
	["glock17"] = {
		sprite = 12,
		stack_size = 1,
		type = "gun",
		data = {
			fire_rate = 0.01,
			mag_size = 17,
		}
	}
}

local player = {
	x = 320.0,
	y = 240.0,
	size = 1,
	sp = 388,
	tw = 4,
	th = 4,
	spd = 3,

	inventory = {
		items = {
			name = "glock17",
			amount = 3,
		},
		equipped = 0,
	}
}

local particles = {}
local particle_timer = 0

local fishes = {}

local fish_cap = 16

local function random_float(from, to)
	return from + math.random() * (to - from)
end

Keys = {
	A = 1,
	D = 4,
	W = 23,
	S = 19,
}

local function new_particle()
	local p = {
		x = 320,
		y = 240,
		x_speed = random_float(-0.5, 0.5),
		y_speed = random_float(-0.5, -2),
		radius = math.random(1, 5),
		-- color = 173,
		color = 15,
		lifetime = 120,
	}

	table.insert(particles, p)
end

local function new_fish()
	local f = {
		x = math.random(-640, -32),
		y = math.random(0, 480),
		dir_x = 0.2,
		dir_y = random_float(-0.2, 0.2),
		sprite = 400,
		sw = 2,
		sh = 2,
	}

	table.insert(fishes, f)

	--fish_num = fish_num + 1
end

function _init()
	print("time: " .. os.time())
	math.randomseed(os.time())

	--new_fish()
	--new_fish()
	--new_fish()
end

function _update()
	particle_timer = particle_timer + 1

	if particle_timer == 3 then
		new_particle()
		particle_timer = 0
	end

	for i,p in ipairs(particles) do
		p.x = p.x + p.x_speed
		p.y = p.y + p.y_speed
		p.lifetime = p.lifetime - 1

		if p.lifetime == 0 then
			table.remove(particles, i)
		end
	end

	if #fishes < fish_cap then
		new_fish()
	end

	
	for i,f in ipairs(fishes) do
		f.x = f.x + f.dir_x
		f.y = f.y + f.dir_y

		if f.x >= 640 + 32 then
			table.remove(fishes, i)
			--fish_num = fish_num - 1
		end
	end

	-- Input
	if key(Keys.A) then
		player.x = player.x - player.spd
	elseif key(Keys.D) then
		player.x = player.x + player.spd
	end

	if key(Keys.W) then
		player.y = player.y - player.spd
	elseif key(Keys.S) then
		player.y = player.y + player.spd
	end
end

function _draw()
	-- Dark blue color
	cls(151)

	-- Draw the map
	--map(0, 0, 0, 0, 0, 80, 60)
	--map(1, 0, 0, 0, 0, 80, 60)

	spr(772, 320-8, 240, 2, 2)

	


	for i = 1, 15 do
		spr(868, 320-8, 240 + i * 16, 2, 2)
	end

	for i,p in ipairs(particles) do
		circ(p.x, p.y, p.radius, p.color)
	end

	for i,f in ipairs(fishes) do
		spr(f.sprite, f.x, f.y, f.sw, f.sh)
	end

	spr(player.sp, player.x, player.y, player.tw, player.th)
end

print("jatoch broer")

