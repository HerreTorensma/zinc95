<<< lua >>>
local particles = {}
local particle_timer = 0

local function random_float(from, to)
	return from + math.random() * (to - from)
end

local function new_particle()
	local p = {
		x = 320,
		y = 240,
		x_speed = random_float(-0.5, 0.5),
		y_speed = random_float(-0.5, -2),
		radius = math.random(1, 5),
		color = 15,
		lifetime = 120
	}

	table.insert(particles, p)
end

function _init()
	math.randomseed(os.time())
end

function _update()
	particle_timer = particle_timer + 1

	if particle_timer == 5 then
		new_particle()
		particle_timer = 0
	end

	for i,p in ipairs(particles) do
		p.x = p.x + p.x_speed
		p.y = p.y + p.y_speed
		p.lifetime = p.lifetime - 1

		if p.lifetime == 0 then
			table.remove(particles, i)
		end
	end
end

function _draw()
	cls(56)

	for i,p in ipairs(particles) do
		circ(p.x, p.y, p.radius, p.color)
	end

	spr(768, 320-8, 240, 2, 2)

	for i = 1, 15 do
		spr(864, 320-8, 240 + i * 16, 2, 2)
	end
end


