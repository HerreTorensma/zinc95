local player = {
	x = 320,
	y = 240,
	size = 1
}

local particles = {}
local particle_timer = 0

local fishes = {}

local function random_float(from, to)
	return from + math.random() * (to - from)
end

local function new_particle()
	local p = {
		x = 320,
		y = 240,
		x_speed = random_float(-0.5, 0.5),
		y_speed = random_float(-0.5, -2),
		radius = math.random(1, 5),
		-- color = 173,
		color = 15,
		lifetime = 120
	}

	table.insert(particles, p)
end

local function new_fish()
	local f = {
		x = math.random(0, 640),
		y = math.random(0, 480),
		s = 400,
		sw = 2,
		sh = 2
	}

	table.insert(fishes, f)
end

function _init()
	print("time: " .. os.time())
	math.randomseed(os.time())

	new_fish()
	new_fish()
	new_fish()
end

function _update()
	particle_timer = particle_timer + 1

	if particle_timer == 3 then
		new_particle()
		particle_timer = 0
	end

	for i,p in ipairs(particles) do
		p.x = p.x + p.x_speed
		p.y = p.y + p.y_speed
		p.lifetime = p.lifetime - 1

		if p.lifetime == 0 then
			table.remove(particles, i)
		end
	end


	for i,p in ipairs(fishes) do
		p.x = p.x + random_float(-2, 2)
		p.y = p.y + random_float(-2, 2)
	end
end

function _draw()
	cls(151)

	spr(772, 320-8, 240, 2, 2)

	for i = 1, 15 do
		spr(868, 320-8, 240 + i * 16, 2, 2)
	end

	for i,p in ipairs(particles) do
		circ(p.x, p.y, p.radius, p.color)
	end

	for i,p in ipairs(fishes) do
		spr(p.s, p.x, p.y, p.sw, p.sh)
	end
end

print("jatoch broer")

